# MESIS configuration (all optional)
MESIS_PORT=8000              # port for server/server.py (also --port)
MESIS_DIST=web/dist          # built site directory served by the API server (also --dist)
MESIS_DATA=web/public/data   # canonical gzip data package read by the API (also --data)
# No API keys are required. The AI mission assistant uses Claude only when the page is opened inside
# Claude (artifact runtime); everywhere else it is hidden and all analysis tools still work.
